def flag_img(time: str, width: int = 24) -> str:
    codigo = CODIGOS.get(time, "un")
    return (
        f'<img src="https://flagcdn.com/w40/{codigo}.png" '
        f'width="{width}" style="vertical-align:middle; margin-right:4px;">'
    )
